# Site URL used for absolute metadata URLs, sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://nr-associates.com

# --- Contact form email delivery (app/api/contact/route.ts) ---
# The API route validates and logs submissions out of the box.
# To actually deliver emails, wire up a provider such as Resend
# (https://resend.com) and set these values:
RESEND_API_KEY=
CONTACT_TO_EMAIL=admin@nr-associates.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
